# Copy to .env.local. Empty values are unset. Do not commit .env.local.
# Milestone marks when the product needs the variable. See README.

# now — Postgres. This URL matches docker-compose.yml.
# On Vercel, replace it with the Neon connection string from the Marketplace
# (the pooled host, hostname containing "-pooler", is the one to use).
DATABASE_URL=postgres://wardrobe:wardrobe@localhost:5432/wardrobe

# foundation — public origin, no trailing slash. Canonical URLs and sitemaps.
# NEXT_PUBLIC_SITE_URL=https://theoldwardrobe.example

# auth — required before sign-in works. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# auth — site origin for OAuth callbacks. Use http://localhost:3000 locally.
# Leave unset on Vercel Preview so each preview URL is inferred from the request.
BETTER_AUTH_URL=http://localhost:3000

# auth — Google sign-in. The button is hidden until both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# auth — Facebook sign-in. The button is hidden until both are set.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# sell flow — Vercel Blob. The browser uploads to a server-issued pathname; the server then reads the stored bytes. New photos are not written to public/uploads.
BLOB_READ_WRITE_TOKEN=

# auth — verification email. Both are required before email sign-up is offered.
# Until then sign-up stays unavailable and no account is created.
RESEND_API_KEY=
EMAIL_FROM=

# AI description draft. Stays off unless AI_DRAFT=on and the gateway key are both set.
# Leave AI_DRAFT unset. Do not put a key here.
# AI_DRAFT=on
AI_GATEWAY_API_KEY=
